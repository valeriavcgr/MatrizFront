generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model centro_formacion {
  id_centro_formacion  Int                 @id
  nom_centro_formacion String              @db.VarChar(50)
  sigla                String              @db.VarChar(10)
  fk_tdoc_subdirector  String              @db.VarChar(10)
  fk_id_subdirector    BigInt
  subdirector          subdirector         @relation(fields: [fk_tdoc_subdirector, fk_id_subdirector], references: [pkfk_tdoc_subdirec, pkfk_id_subdirec], onDelete: Cascade, map: "fk_centro_formacion_subdirector1")
  documento_trabajo    documento_trabajo[]
  programas            programas[]
}

model criterio_priorizacion {
  n_variable             Int                 @id @default(autoincrement())
  variable               String              @db.VarChar(40)
  contexto_evidencia_reg String
  estado_criterio        Boolean             @default(true)
  fk_glosario_estrategia Int
  glosario_estrategia    glosario_estrategia @relation(fields: [fk_glosario_estrategia], references: [id_estrategia], onDelete: Cascade, map: "fk_criterio_priorizacion_glosario_estrategia1")
  programa_criterio      programa_criterio[]
}

model doc_trabajo_programa {
  pkfk_n_programa   Int
  pkfk_doc_trabajo  Int
  fk_modalidad      Int
  fk_tipo_oferta    Int
  fk_jornada        Int
  documento_trabajo documento_trabajo   @relation(fields: [pkfk_doc_trabajo], references: [id_documento_trabajo], onDelete: Cascade, map: "fk_programas_has_documento_trabajo_documento_trabajo1")
  jornadas          jornadas            @relation(fields: [fk_jornada], references: [cod_jornada], onDelete: Cascade, map: "fk_programas_has_documento_trabajo_jornadas1")
  modalidad         modalidad           @relation(fields: [fk_modalidad], references: [cod_modalidad], onDelete: Cascade, map: "fk_programas_has_documento_trabajo_modalidad1")
  programas         programas           @relation(fields: [pkfk_n_programa], references: [n_programa], onDelete: Cascade, map: "fk_programas_has_documento_trabajo_programas")
  tipo_oferta       tipo_oferta         @relation(fields: [fk_tipo_oferta], references: [cod_tipo_oferta], onDelete: Cascade, map: "fk_programas_has_documento_trabajo_tipo_oferta1")
  programa_criterio programa_criterio[]

  @@id([pkfk_n_programa, pkfk_doc_trabajo])
}

model documento_trabajo {
  id_documento_trabajo   Int                    @id
  fk_n_oferta            Int
  fecha_diligenciamiento DateTime               @db.Timestamp(6)
  fk_centro_formacion    Int
  fk_matriz_priorizacion Int
  fk_referente_tdoc      String                 @db.VarChar(10)
  fk_referente_id        BigInt
  doc_trabajo_programa   doc_trabajo_programa[]
  centro_formacion       centro_formacion       @relation(fields: [fk_centro_formacion], references: [id_centro_formacion], onDelete: Cascade, map: "fk_documento_trabajo_centro_formacion1")
  matriz_priorizacion    matriz_priorizacion    @relation(fields: [fk_matriz_priorizacion], references: [id_matriz_priorizacion], onDelete: Cascade, map: "fk_documento_trabajo_matriz_priorizacion1")
  oferta                 oferta                 @relation(fields: [fk_n_oferta], references: [n_oferta], onDelete: Cascade, map: "fk_documento_trabajo_oferta1")
  referente_planeacion   referente_planeacion   @relation(fields: [fk_referente_tdoc, fk_referente_id], references: [pkfk_tdoc_referente, pkfk_id_referente], onDelete: Cascade, map: "fk_documento_trabajo_referente_planeacion1")
}

model glosario_estrategia {
  id_estrategia         Int                     @id
  glosario_estrategia   String                  @db.VarChar(45)
  definicion_estrategia String
  estado_estrategia     Boolean                 @default(true)
  criterio_priorizacion criterio_priorizacion[]
}

model jornadas {
  cod_jornada          Int                    @id @default(autoincrement())
  jornada              String                 @db.VarChar(15)
  estado_jornada       Boolean                @default(true)
  doc_trabajo_programa doc_trabajo_programa[]
}

model matriz_priorizacion {
  id_matriz_priorizacion Int                 @id
  version                Decimal             @db.Decimal(3, 1)
  year_oferta            Int
  documento_trabajo      documento_trabajo[]
}

model modalidad {
  cod_modalidad        Int                    @id @default(autoincrement())
  tipo_modalidad       String                 @db.VarChar(15)
  estado_modalidad     Boolean                @default(true)
  doc_trabajo_programa doc_trabajo_programa[]
}

model oferta {
  n_oferta          Int                 @id
  desc_oferta       String              @db.VarChar(50)
  estado_oferta     Boolean             @default(true)
  documento_trabajo documento_trabajo[]
}

model programa_criterio {
  pkfk_programa              Int
  pkfk_docu_trabajo          Int
  pkfk_criterio_priorizacion Int
  argumento                  String
  soporte_argumento          Bytes
  criterio_priorizacion      criterio_priorizacion @relation(fields: [pkfk_criterio_priorizacion], references: [n_variable], onDelete: Cascade, map: "fk_programas_has_documento_trabajo_has_criterio_c1")
  doc_trabajo_programa       doc_trabajo_programa  @relation(fields: [pkfk_programa, pkfk_docu_trabajo], references: [pkfk_n_programa, pkfk_doc_trabajo], onDelete: Cascade, map: "fk_programas_has_documento_trabajo_has_criterio_p1")

  @@id([pkfk_programa, pkfk_docu_trabajo, pkfk_criterio_priorizacion])
}

model programas {
  n_programa           Int                    @id
  nom_programa         String                 @db.VarChar(50)
  sigla_prog           String                 @db.VarChar(15)
  version_prog         String                 @db.VarChar(5)
  estado_programa      Boolean                @default(true)
  fk_linea_medular     Int
  doc_trabajo_programa doc_trabajo_programa[]
  centro_formacion     centro_formacion       @relation(fields: [fk_linea_medular], references: [id_centro_formacion], onDelete: Cascade, map: "fk_programas_centro_formacion1")
}

model referente_planeacion {
  pkfk_tdoc_referente String              @db.VarChar(10)
  pkfk_id_referente   BigInt
  estado_referente    Boolean             @default(true)
  documento_trabajo   documento_trabajo[]
  usuarios            usuarios            @relation(fields: [pkfk_tdoc_referente, pkfk_id_referente], references: [pkfk_tdoc, id_usuarios], onDelete: Cascade, map: "fk_referente_planeacion_usuarios1")

  @@id([pkfk_tdoc_referente, pkfk_id_referente])
}

model roles {
  id_roles Int        @id
  rol      String     @db.VarChar(20)
  usuarios usuarios[]
}

model subdirector {
  pkfk_tdoc_subdirec String             @db.VarChar(10)
  pkfk_id_subdirec   BigInt
  estado_subdirector Boolean            @default(true)
  centro_formacion   centro_formacion[]
  usuarios           usuarios           @relation(fields: [pkfk_tdoc_subdirec, pkfk_id_subdirec], references: [pkfk_tdoc, id_usuarios], onDelete: Cascade, map: "fk_subdirector_usuarios")

  @@id([pkfk_tdoc_subdirec, pkfk_id_subdirec])
}

model tipo_documento {
  tipo_doc  String     @id @db.VarChar(10)
  desc_tdoc String     @db.VarChar(25)
  usuarios  usuarios[]
}

model tipo_oferta {
  cod_tipo_oferta      Int                    @id @default(autoincrement())
  desc_tipo_oferta     String                 @db.VarChar(35)
  estado_tipo_oferta   Boolean                @default(true)
  doc_trabajo_programa doc_trabajo_programa[]
}

model usuarios {
  fk_rol               Int
  pkfk_tdoc            String                @db.VarChar(10)
  id_usuarios          BigInt
  nombres_usu          String                @db.VarChar(40)
  apellidos_usu        String                @db.VarChar(40)
  estado_usu           Boolean               @default(true)
  correo_institucional String                @unique(map: "uq_usuarios_correo") @db.VarChar(50)
  pass_usu             String                @db.VarChar(255)
  referente_planeacion referente_planeacion?
  subdirector          subdirector?
  roles                roles                 @relation(fields: [fk_rol], references: [id_roles], onDelete: Cascade, map: "fk_usuarios_roles1")
  tipo_documento       tipo_documento        @relation(fields: [pkfk_tdoc], references: [tipo_doc], onDelete: Cascade, map: "fk_usuarios_tipo_documento")

  @@id([pkfk_tdoc, id_usuarios])
}
